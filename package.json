{
  "name": "herafricatable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-repository.mjs",
    "test:journeys": "node scripts/verify-journey-states.mjs",
    "test:accessibility": "node scripts/verify-accessibility-contracts.mjs",
    "test:operations": "node scripts/verify-operations-contracts.mjs",
    "test": "npm run verify && npm run test:journeys && npm run test:accessibility && npm run test:operations && npm run typecheck",
    "test:live": "node scripts/smoke-live.mjs",
    "ops:auth-readiness": "node --env-file=.env.local scripts/smoke-authenticated.mjs",
    "ops:provision-beta-admin": "node --env-file=.env.local scripts/provision-beta-admin.mjs",
    "ops:provision-community-test-cohort": "node --env-file=.env.local --env-file=.env.test.local scripts/provision-community-test-cohort.mjs",
    "ops:community:accept-test-invitations": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-community-test-invitations.mjs",
    "ops:community:accept-member-journeys": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-community-member-journeys.mjs",
    "ops:community:accept-scale": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-community-scale.mjs",
    "ops:community:accept-safety": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-community-safety.mjs",
    "ops:community:accept-membership-lifecycle": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-community-membership-lifecycle.mjs",
    "ops:community:event-readiness": "node --env-file=.env.local scripts/verify-community-event-readiness.mjs",
    "ops:community:accept-events": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-community-events.mjs",
    "ops:verify-admin": "node --env-file=.env.local scripts/verify-admin-identity.mjs",
    "ops:email-readiness": "node --env-file=.env.local scripts/verify-email-provider-readiness.mjs",
    "ops:membership:intake-readiness": "node --env-file=.env.local scripts/verify-membership-intake-readiness.mjs",
    "ops:membership:accept-intake": "node --env-file=.env.local --env-file=.env.test.local scripts/accept-membership-intake.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.6",
    "next": "16.2.10",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
