# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use a Supabase sb_secret_ key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical application URL. Use the production domain in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add these when the integrations are activated.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Paystack signs webhooks with PAYSTACK_SECRET_KEY; there is no separate webhook secret.
RESEND_API_KEY=
EMAIL_FROM=Her Africa Table <community@caseready.africa>
# Random server-only secret used by Vercel Cron to process queued notifications.
CRON_SECRET=

# Server-only Table Guide configuration. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional; the application defaults to the cost-conscious concierge model.
OPENAI_MODEL=gpt-5.6-luna
# Random 32+ character salt for stable privacy-preserving safety identifiers.
AI_SAFETY_SALT=

# Local or CI-only authenticated acceptance identity. Always use a test-tagged
# account; never commit real values or add these to the browser bundle.
HAT_TEST_EMAIL=
HAT_TEST_PASSWORD=

# Local-only Community acceptance cohort. Keep values in .env.test.local.
HAT_COMMUNITY_TEST_PASSWORD=
HAT_COMMUNITY_TEST_SLUG=nairobi-founding-table
HAT_ADMIN_TEST_EMAIL=
HAT_ADMIN_TEST_PASSWORD=
# Set to 1 only for the controlled 45-conversation scale rehearsal.
HAT_COMMUNITY_SCALE_WRITE=0
